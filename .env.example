# Copia este archivo a .env.local para desarrollo local (nunca subas .env.local).
# En producción (Vercel), añade estas mismas variables en
# Project Settings -> Environment Variables.

# Google PageSpeed Insights API (gratis, cuota diaria muy alta)
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=

# Airtable: guarda los leads del auditor de webs y limita el abuso
# (Personal Access Token con permisos data.records:read y data.records:write
# sobre la base, y Base ID de la tabla "Leads" con los campos:
# Nombre, Email, Optica, URL, Puntuacion, IP, Fecha)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Brevo: envío opcional del informe por email (plan gratuito, 300 emails/día)
# https://www.brevo.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
